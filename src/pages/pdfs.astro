---
/**
 * /pdfs/: the three editions of the book, each with a miniature of how its
 * pages are set, drawn from the booklet's first explained passage, and links to
 * each format: the 7 × 10 in PDF (KDP), the Letter PDF for printing at home,
 * and the EPUB. The PDFs are built by scripts/build-pdf.ts and the EPUBs by
 * scripts/build-epub.ts; the deploy workflow copies them to the site root
 * (README "Print-ready PDF for KDP" and "EPUB").
 */
import Base from '../layouts/Base.astro';
import { loadGuide, type UnitModel } from '../lib/content';
import { BOOK_EPUBS, BOOK_PDFS, BOOK_PDFS_LETTER, chaptersTitle } from '../lib/chapters';

const guide = loadGuide();
const base = import.meta.env.BASE_URL;

/** The first passage that has an explanation, and the concept it belongs to: the miniatures' sample. */
const sample = (() => {
  for (const c of guide.chapters) {
    for (const k of c.concepts) {
      const units = k.units.filter((u) => u.explanationHtml !== null);
      if (units[0]) return { concept: k, units };
    }
  }
  return null;
})();

/** The first paragraph of an explanation, without the class references (▶ links). */
const firstPara = (u: UnitModel): string => {
  const html = u.explanationHtml ?? '';
  const p = /<p>([\s\S]*?)<\/p>/.exec(html)?.[1] ?? html;
  return p.replace(/<a class="listen"[\s\S]*?<\/a>/g, '').replace(/\s+([.,;:])/g, '$1');
};
const hebrew = (u: UnitModel): string => u.segments[0]?.lines.map((l) => l.text).join(' ') ?? '';
/** Translation without footnote markers. */
const english = (u: UnitModel): string => (u.segments[0]?.en ?? '').replace(/<sup[^>]*>[\s\S]*?<\/sup>/g, '');

interface Edition {
  key: 'guide' | 'explanation' | 'hebrew';
  name: string;
  he?: string;
  tagline: string;
  contents: string[];
  /** The 7 × 10 in PDF. */
  file: string;
  /** The Letter PDF, for printing at home. */
  letter: string;
  epub: string;
}

const editions: Edition[] = [
  {
    key: 'guide',
    name: 'Study guide',
    tagline: 'The full book: text, translation and explanation together.',
    contents: [
      'The Hebrew beside Rabbi Markel’s English translation, with his footnotes',
      'The explanation under each passage, from his recorded class',
      'Overviews, key terms, review questions and a glossary',
    ],
    file: BOOK_PDFS.guide,
    letter: BOOK_PDFS_LETTER.guide,
    epub: BOOK_EPUBS.guide,
  },
  {
    key: 'hebrew',
    name: 'Hebrew and explanation',
    tagline: 'For learning from the original: the whole Hebrew, then the explanation.',
    contents: [
      'The whole Hebrew text, paragraph by paragraph (§)',
      'The explanation under each passage; passages without one are given in Hebrew alone',
      'No translation; the explanations quote it in bold',
    ],
    file: BOOK_PDFS.hebrew,
    letter: BOOK_PDFS_LETTER.hebrew,
    epub: BOOK_EPUBS.hebrew,
  },
  {
    key: 'explanation',
    name: 'Explanation only',
    tagline: 'The explanations as continuous prose, for reading straight through.',
    contents: [
      'Each explanation headed by the opening words of its passage in Hebrew',
      'Neither the full text nor the translation',
      'The shortest of the three',
    ],
    file: BOOK_PDFS.explanation,
    letter: BOOK_PDFS_LETTER.explanation,
    epub: BOOK_EPUBS.explanation,
  },
];
---

<Base title="PDFs and ebooks" current="pdfs" description="Download the Shaar HaYichud study guide: three editions, each as a 7 × 10 in PDF, a Letter PDF for printing at home, and an EPUB ebook.">
  <div class="page pdfs-page">
    <header class="page-head pdfs-head">
      <p class="eyebrow"><span>Booklet 1 · {chaptersTitle()}</span></p>
      <h1 class="chapter-title">The book, in three editions</h1>
      <p class="lede">
        The whole booklet in three editions. They contain the same explanations; they differ in how much of the text comes with them. Each comes as a
        typeset PDF (7 × 10 in, the book), the same pages on Letter paper for printing at home, and an EPUB for ebook readers.
      </p>
    </header>

    <ul class="pdf-grid">
      {
        editions.map((e) => (
          <li class={`pdf-card pdf-${e.key}`}>
            <a class="pdf-preview" href={`${base}${e.file}`} aria-label={`Open the ${e.name} PDF`}>
              <div class="mini" aria-hidden="true">
                {sample && (
                  <>
                    <p class="mini-title">{sample.concept.title.split(':')[0]}</p>
                    {e.key === 'guide' &&
                      sample.units.slice(0, 1).map((u) => (
                        <>
                          <div class="mini-pair">
                            <p class="mini-en">
                              <b>§{u.from}</b> <Fragment set:html={english(u)} />
                            </p>
                            <p class="mini-he" lang="he" dir="rtl">
                              {hebrew(u)}
                            </p>
                          </div>
                          <p class="mini-label">Explanation {u.label}</p>
                          <p class="mini-prose">
                            <Fragment set:html={firstPara(u)} />
                          </p>
                        </>
                      ))}
                    {e.key === 'hebrew' &&
                      sample.units.slice(0, 2).map((u) => (
                        <>
                          <p class="mini-row">
                            <span class="mini-ref">§{u.from}</span>
                            <span class="mini-he" lang="he" dir="rtl">
                              {hebrew(u)}
                            </span>
                          </p>
                          <p class="mini-prose">
                            <Fragment set:html={firstPara(u)} />
                          </p>
                        </>
                      ))}
                    {e.key === 'explanation' &&
                      sample.units.slice(0, 3).map((u) => (
                        <>
                          <p class="mini-row">
                            <span class="mini-ref">{u.label}</span>
                            <span class="mini-he" lang="he" dir="rtl">
                              {u.incipit}
                            </span>
                          </p>
                          <p class="mini-prose">
                            <Fragment set:html={firstPara(u)} />
                          </p>
                        </>
                      ))}
                  </>
                )}
              </div>
            </a>
            <div class="pdf-body">
              <h2 class="pdf-name">{e.name}</h2>
              <p class="pdf-tagline">{e.tagline}</p>
              <ul class="pdf-contents">
                {e.contents.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
              <div class="pdf-actions">
                <a class="btn btn-primary" href={`${base}${e.file}`} download>
                  PDF, 7 × 10 in
                </a>
                <a class="btn" href={`${base}${e.letter}`} download>
                  PDF, Letter
                </a>
                <a class="btn" href={`${base}${e.epub}`} download>
                  EPUB
                </a>
                <a class="pdf-open" href={`${base}${e.file}`}>
                  Open in the browser
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <aside class="draft-full" aria-label="Draft notice">
      <p class="draft-full-head">Draft for review</p>
      <p>
        Every page of these PDFs, and every chapter of the EPUBs, carries a draft notice. The explanations were drafted by AI from recordings of Rabbi Markel’s classes and have not
        yet been reviewed by him. Do not rely on them or distribute them.
      </p>
    </aside>

    <section class="prose pdfs-notes">
      <h2>About the formats</h2>
      <p>
        <strong>PDF, 7 × 10 in</strong> is a paperback interior for print on demand: black and white, fonts embedded, chapters starting on a
        right-hand page, with contents and glossary page numbers.
      </p>
      <p>
        <strong>PDF, Letter</strong> is the same book on 8.5 × 11 in paper, for printing at home: the pages are scaled up (the text is about
        12.5 pt), the side margins are equal and wide enough for a hole punch, and there are no blank pages, so it prints single- or
        double-sided. Print at 100% (“actual size”), not “fit to page”.
      </p>
      <p>
        <strong>EPUB</strong> is for ebook readers (Apple Books, Kobo, Google Play Books, and Kindle through Send to Kindle). The text reflows to
        the screen, so the Hebrew and the translation of each passage come one after the other rather than side by side. Class references
        such as “(class 21, 4:12)” link to the recording.
      </p>
      <p>
        The paragraph numbers (§) are those of the English translation on Sefaria, the same in every edition and format and on this site, so a
        passage can be found in any of them. To print a few pages only, use the <a href={`${base}booklet/`}>whole booklet</a> page, which prints in
        whichever view you choose.
      </p>
    </section>
  </div>
</Base>
