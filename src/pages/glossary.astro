---
import Base from '../layouts/Base.astro';
import GlossaryList from '../components/GlossaryList.astro';
import { glossary, loadGuide } from '../lib/content';
import { chaptersTitle } from '../lib/chapters';

const guide = loadGuide();
const terms = glossary(guide);
const letters = [...new Set(terms.map((t) => t.term.charAt(0).toUpperCase()))];
---

<Base title="Glossary" current="glossary">
  <div class="page">
    <header class="page-head">
      <p class="eyebrow"><span>Booklet 1 · {chaptersTitle()}</span></p>
      <h1 class="chapter-title">Glossary</h1>
      <p class="lede">
        The key terms of each chapter, in the transliteration this guide uses. Each is glossed as it is explained in the classes, and linked to
        the chapter where it first appears.
      </p>
    </header>
    {terms.length === 0 && <p class="notice">No key terms have been written yet.</p>}
    {
      letters.length > 1 && (
        <nav class="letter-index" aria-label="Letters">
          {letters.map((l) => (
            <a href={`#letter-${l}`}>{l}</a>
          ))}
        </nav>
      )
    }
    <GlossaryList terms={terms} />
  </div>
</Base>
