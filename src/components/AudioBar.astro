---
import { loadGuide, playerSources } from '../lib/content';

const json = JSON.stringify(playerSources(loadGuide())).replace(/</g, '\\u003c');
---

<div class="player" id="player" role="region" aria-label="Class audio" hidden>
  <audio preload="none"></audio>
  <div class="player-inner">
    <button type="button" class="player-btn" data-act="back" aria-label="Back 15 seconds">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V2L7 6l5 4V7a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8z"></path></svg>
      <span class="player-skip">15</span>
    </button>
    <button type="button" class="player-btn player-play" data-act="toggle" aria-label="Play">
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z"></path></svg>
    </button>
    <button type="button" class="player-btn" data-act="fwd" aria-label="Forward 15 seconds">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V2l5 4-5 4V7a6 6 0 1 0 6 6h2a8 8 0 1 1-8-8z"></path></svg>
      <span class="player-skip">15</span>
    </button>
    <div class="player-meta">
      <div class="player-row">
        <span class="player-title" data-el="title">Class audio</span>
        <span class="player-time" data-el="time" aria-live="off">0:00</span>
      </div>
      <input class="player-seek" data-el="seek" type="range" min="0" max="100" step="1" value="0" aria-label="Position in class" />
    </div>
    <button type="button" class="player-btn player-close" data-act="close" aria-label="Close player">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.4 5 5 6.4 10.6 12 5 17.6 6.4 19l5.6-5.6 5.6 5.6 1.4-1.4-5.6-5.6L19 6.4 17.6 5 12 10.6z"></path></svg>
    </button>
  </div>
</div>
<script type="application/json" id="player-sources" set:html={json} />
